# All optional. Leave unset and the site runs with no analytics and no verification tag.
# NEXT_PUBLIC_* values are baked in at build time: redeploy after changing them on Vercel.

# Google Analytics 4 measurement ID, e.g. G-ABC123XYZ. GA loads only when this is set
# (kid-safe config: ad storage/personalization denied, Google signals off, IP anonymized).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console "HTML tag" verification token (just the content="..." value).
# Renders <meta name="google-site-verification"> only when set. Not needed if you verify by DNS.
NEXT_PUBLIC_GSC_VERIFICATION=

# Bot Camp teacher sample (Kit). Leave unset to show a "coming soon" form.
# Set the form ID to enable the form (the teachers page is force-dynamic, so
# KIT_FORM_ID is enough; NEXT_PUBLIC_KIT_FORM_ID is optional). Grade is the
# custom field "grade". The new-lessons checkbox is sent as fields[new_lessons_opt_in]
# only when ticked. Leave KIT_NEW_LESSONS_TAG_ID unset on the free plan (no tag).
# KIT_FORM_ID=
# NEXT_PUBLIC_KIT_FORM_ID=
# KIT_API_KEY=
# KIT_NEW_LESSONS_TAG_ID=
# KIT_GRADE_FIELD=grade

# Bot Camp pack-click redirect. When packUrl in the lab page is later set to
# https://howaiworksforkids.com/bot-camp/pack, clicks 302 here (or to /bot-camp/teachers if unset).
# BOT_CAMP_PACK_URL=

# Bot Camp visit and pack-click totals (numbers only). Vercel Blob on the Hobby
# free tier (private store). Leave unset and counts are skipped, not failed.
# BLOB_READ_WRITE_TOKEN is set automatically when the store is connected to the
# project. Do not commit the token.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# Optional. Leave unset to keep analytics off. Do not commit a real ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional Search Console HTML-tag verification. Leave unset if you verify by DNS.
GOOGLE_SITE_VERIFICATION=

# Future email hook. OFF. The site does not send email and does not read these.
# If you add a sender later, accept only a parent address the parent typed.
# Never accept a child's name or email.
# RESEND_API_KEY=
# PARENT_NOTIFY_WEBHOOK=
